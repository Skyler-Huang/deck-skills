{
  "version": 1,
  "note": "Design tokens for deck building. Colors are #RRGGBB. Sizes are px in a 1280x720 design space (96 dpi); divide by 96 for inches, multiply by 0.75 for points.",
  "presets": {
    "sticker-kids": {
      "label": "贴纸儿童产品",
      "useFor": "小学/儿童产品路演、面向家长与评委；产品界面本身是圆角卡片 + 高饱和撞色",
      "avoidFor": "金融、法律、严肃学术汇报；需要冷静权威感的场合",
      "background": {
        "type": "linear",
        "angle": 90,
        "stops": [["#BFE9FF", 0.0], ["#FFFDF0", 1.0]]
      },
      "ink": "#17384D",
      "inkSoft": "#3F6478",
      "surface": "#FFFFFF",
      "paper": "#FFFDF0",
      "accents": {
        "primary": "#FF6B35",
        "highlight": "#FFD23F",
        "pink": "#FF5D8F",
        "cyan": "#2EC4E6",
        "green": "#7BD389",
        "purple": "#A06CD5"
      },
      "accentsText": {
        "note": "使用品牌色做填充/大色块；文字（尤其 <24pt）用这一组，白底与纸底均 ≥4.5:1",
        "primary": "#C25128",
        "highlight": "#8A7122",
        "pink": "#C4486E",
        "cyan": "#1E7F96",
        "green": "#4A7F52",
        "purple": "#8D5FBB"
      },
      "radiusPx": { "lg": 26, "md": 14, "sm": 9, "pill": 999 },
      "shadow": { "x": 0, "y": 5, "blur": 0, "color": "#17384D", "alpha": 0.16 },
      "fonts": {
        "display": "幼圆",
        "body": "微软雅黑",
        "numeric": "幼圆",
        "mono": "Consolas"
      },
      "motifs": ["四角星", "圆点", "放大镜"],
      "decorBudget": 5,
      "textOnAccent": "#FFFFFF"
    },
    "warm-academic": {
      "label": "温暖学院",
      "useFor": "需要同时显得亲切与严谨的评审场合；纸质、留白、脚注",
      "avoidFor": "纯儿童场景（会偏冷偏正式）",
      "background": {
        "type": "solid",
        "color": "#F7F4EC"
      },
      "ink": "#1A222E",
      "inkSoft": "#39424F",
      "surface": "#FFFFFF",
      "paper": "#F7F4EC",
      "accents": {
        "primary": "#9A6B33",
        "highlight": "#C4A165",
        "pink": "#A02C2C",
        "cyan": "#3F6478",
        "green": "#5C6B52",
        "purple": "#5B4A6B"
      },
      "accentsText": {
        "note": "bronze 与 highlight 在纸底上不足 4.5:1，小字改用这组",
        "primary": "#916530",
        "highlight": "#816A43",
        "pink": "#A02C2C",
        "cyan": "#3F6478",
        "green": "#5C6B52",
        "purple": "#5B4A6B"
      },
      "radiusPx": { "lg": 4, "md": 3, "sm": 2, "pill": 999 },
      "shadow": { "x": 0, "y": 0, "blur": 0, "color": "#1A222E", "alpha": 0.0 },
      "fonts": {
        "display": "宋体",
        "body": "微软雅黑",
        "numeric": "Georgia",
        "mono": "Consolas"
      },
      "motifs": ["细横线", "页码", "脚注"],
      "decorBudget": 3,
      "textOnAccent": "#F4EFE3"
    }
  },
  "typeScale": {
    "note": "pt, for a 13.333x7.5in slide. Never go below 13pt for any visible text.",
    "coverTitle": [52, 64],
    "sectionTitle": [38, 44],
    "pageTitle": [32, 40],
    "subtitle": [18, 22],
    "body": [18, 20],
    "label": [13, 14],
    "footnote": [13, 13],
    "stat": [44, 72]
  },
  "grid": {
    "columns": 12,
    "marginPx": 72,
    "gutterPx": 24,
    "blockGapPx": 40,
    "maxBlocksPerPage": 3,
    "maxBodyCharsPerPage": 80
  }
}
